# 实机、独立采集、独立回放共用的基础依赖；不查找相机SDK或OpenVINO。
find_package(Threads REQUIRED)
if(EXISTS "${VISION_SOURCE_DIR}/.deps/yaml-cpp/yaml-cpp-0.8.0/CMakeLists.txt")
    set(YAML_CPP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(YAML_CPP_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
    add_subdirectory("${VISION_SOURCE_DIR}/.deps/yaml-cpp/yaml-cpp-0.8.0" "${CMAKE_BINARY_DIR}/.deps/yaml-cpp/yaml-cpp-0.8.0" EXCLUDE_FROM_ALL)
else()
    find_package(yaml-cpp REQUIRED)
endif()
if(EXISTS "${VISION_SOURCE_DIR}/.deps/spdlog/spdlog-1.14.1/CMakeLists.txt")
    add_subdirectory("${VISION_SOURCE_DIR}/.deps/spdlog/spdlog-1.14.1" "${CMAKE_BINARY_DIR}/.deps/spdlog/spdlog-1.14.1" EXCLUDE_FROM_ALL)
else()
    find_package(spdlog REQUIRED)
endif()
if(TARGET yaml-cpp::yaml-cpp)
    set(BUFF_YAML_TARGET yaml-cpp::yaml-cpp)
else()
    set(BUFF_YAML_TARGET yaml-cpp)
endif()
find_package(OpenCV 4 REQUIRED COMPONENTS core imgproc imgcodecs videoio calib3d dnn ml)
find_package(Eigen3 3.3 QUIET NO_MODULE)
if(NOT TARGET Eigen3::Eigen)
    find_path(BUFF_EIGEN_INCLUDE Eigen/Core HINTS "${VISION_SOURCE_DIR}/.deps/eigen-3.4.0" PATH_SUFFIXES eigen3 REQUIRED)
    add_library(buff_eigen INTERFACE)
    target_include_directories(buff_eigen SYSTEM INTERFACE "${BUFF_EIGEN_INCLUDE}")
    add_library(Eigen3::Eigen ALIAS buff_eigen)
endif()
